[Desktop Entry]
Type=Application
Name=EasyEffects (Flatpak - modo de serviço)
Comment=Inicia o EasyEffects em segundo plano para processar áudio de entrada e saída
TryExec=/usr/bin/flatpak
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=easyeffects com.github.wwmm.easyeffects --hide-window --service-mode
Terminal=false
StartupNotify=false
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=20
